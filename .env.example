# LiteLLM Docker Application Configuration

# Model to use (Examples: gpt-3.5-turbo, claude-3-sonnet-20240229, gemini-pro)
MODEL_ID=gpt-3.5-turbo

# Your API key for the chosen provider
API_KEY=your-api-key-here

# Prompts to process (supports multiple formats):
# - Single prompt: "What is AI?"
# - Pipe-separated: "Question 1 | Question 2 | Question 3"
# - JSON array: ["Question 1", "Question 2", "Question 3"]
PROMPTS=["What is machine learning?", "Explain Docker in one sentence"]

# Enable verbose logging (true/false)
VERBOSE=false
